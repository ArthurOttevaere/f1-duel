# Copy to .env.local and fill in from the Supabase dashboard (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The live model platform (Flask app), linked from the nav and home page.
NEXT_PUBLIC_MODEL_URL=http://127.0.0.1:5050

# Optional: pin the game season (defaults to the current year).
# NEXT_PUBLIC_SEASON=2026

# Optional: the site's own absolute origin, used to build share-card URLs and
# to sign the race poster with the domain it should send people to. Unset, it
# falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL and then to the current
# production URL — so this only needs setting on a custom domain, but on one it
# is worth setting: it is what stops an exported poster printing a vercel.app
# address when someone reaches the site that way.
# NEXT_PUBLIC_SITE_URL=https://f1duel.example

# Optional: the address /contact publishes for bug reports and suggestions.
# Unset, the page points at GitHub Issues only. Use a mailbox made for the
# project — it goes on a public page.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
